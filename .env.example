# Resend API Configuration
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender Email
# If you haven't verified a domain on Resend, you can use: onboarding@resend.dev
# If you have verified your domain, use: assistant@yourdomain.com
RESEND_FROM=onboarding@resend.dev

# Recipient Email (Your personal email to receive alerts)
# Note: With free onboarding@resend.dev, you can only send to the email you used to register Resend.
NOTIFY_TO_EMAIL=your_email@gmail.com

# System Timezone (Default: Asia/Ho_Chi_Minh for GMT+7)
TIMEZONE=Asia/Ho_Chi_Minh
