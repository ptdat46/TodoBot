# TodoBot deployment configuration (never commit .env)
# Web server bind address and port; put HTTPS/reverse proxy or VPN in front for IP access.
WEB_HOST=127.0.0.1
WEB_PORT=8080
APP_HOST=127.0.0.1
APP_PORT=8080
APP_ENV=production
APP_PASSWORD_HASH=replace_with_scrypt_hash
SESSION_SECRET=replace_with_long_random_secret

# Local timezone used by reminder scheduling.
TIMEZONE=Asia/Ho_Chi_Minh

# Optional OpenAI-compatible backend configuration for the application.
AI_BASE_URL=https://your-openai-compatible-endpoint/v1
AI_API_KEY=replace_me
AI_MODEL=gpt-6-luna
MAX_UPLOAD_BYTES=52428800
UPLOAD_DIR=uploads
VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:you@example.com
