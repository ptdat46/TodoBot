# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID of the recipient (start a chat with your bot before testing)
TELEGRAM_CHAT_ID=9163961090

# OpenAI-Compatible AI API Configuration (for 2-way Telegram Agent Chat)
AI_BASE_URL=https://your-openai-compatible-endpoint/v1
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-6-luna

# System Timezone (Default: Asia/Ho_Chi_Minh for GMT+7)
TIMEZONE=Asia/Ho_Chi_Minh
